{
  "_note": "Exemplar: business letter / letterhead, Midnight palette. Slim letterhead rule (not a heavy band), sender block, date, recipient, body, sign-off. Mostly left-aligned, generous whitespace. Adapt copy/variables; preview and revise.",
  "name": "Letter",
  "tools": [
    {
      "tool": "add_elements",
      "input": {
        "elements": [
          { "id": "sender", "type": "text", "position": { "x": 50, "y": 50, "w": 360, "h": 24 }, "data": { "content": "Acme Tech Solutions" }, "styles": { "fontFamily": "google:poppins", "fontSize": 18, "bold": true, "color": "#0F172A" } },
          { "id": "senderAddr", "type": "text", "position": { "x": 50, "y": 74, "w": 360, "h": 16 }, "data": { "content": "221 Innovation Way · San Francisco, CA" }, "styles": { "fontFamily": "google:inter", "fontSize": 10, "color": "#64748B" } },
          { "id": "headRule", "type": "shape", "position": { "x": 50, "y": 100, "w": 495, "h": 2 }, "data": { "shapeType": "rectangle" }, "styles": { "fill": "#3B82F6" } },

          { "id": "date", "type": "text", "position": { "x": 50, "y": 130, "w": 300, "h": 16 }, "data": { "content": "7 June 2026" }, "styles": { "fontFamily": "google:inter", "fontSize": 11, "color": "#0F172A" } },

          { "id": "recipient", "type": "text", "position": { "x": 50, "y": 168, "w": 360, "h": 56 }, "data": { "content": "Ms. Dana Howard\nDirector of Operations\nGlobex Corporation" }, "styles": { "fontFamily": "google:inter", "fontSize": 11, "color": "#0F172A", "lineHeight": 1.4 } },

          { "id": "salutation", "type": "text", "position": { "x": 50, "y": 244, "w": 360, "h": 18 }, "data": { "content": "Dear Ms. Howard," }, "styles": { "fontFamily": "google:inter", "fontSize": 11, "color": "#0F172A" } },
          { "id": "body", "type": "text", "position": { "x": 50, "y": 274, "w": 495, "h": 260 }, "data": { "content": "Thank you for taking the time to meet with our team last week. We were glad to learn more about Globex's goals for the coming year, and we believe our consultancy can help you reach them.\n\nEnclosed is a summary of the engagement we discussed, along with proposed timelines and milestones. Please review at your convenience — we are happy to adjust the scope to fit your priorities.\n\nWe look forward to working together." }, "styles": { "fontFamily": "google:inter", "fontSize": 11, "color": "#334155", "lineHeight": 1.6 } },

          { "id": "signoff", "type": "text", "position": { "x": 50, "y": 560, "w": 300, "h": 18 }, "data": { "content": "Sincerely," }, "styles": { "fontFamily": "google:inter", "fontSize": 11, "color": "#0F172A" } },
          { "id": "signName", "type": "text", "position": { "x": 50, "y": 600, "w": 300, "h": 18 }, "data": { "content": "Alex Rivera" }, "styles": { "fontFamily": "google:source-serif-4", "fontSize": 13, "bold": true, "color": "#0F172A" } },
          { "id": "signTitle", "type": "text", "position": { "x": 50, "y": 620, "w": 300, "h": 16 }, "data": { "content": "Principal Consultant" }, "styles": { "fontFamily": "google:inter", "fontSize": 10, "color": "#64748B" } }
        ]
      }
    },
    {
      "tool": "bind_variables",
      "input": {
        "bindings": [
          { "nodeId": "date", "field": "content", "type": "text", "name": "letter_date" },
          { "nodeId": "recipient", "field": "content", "type": "text", "name": "recipient_block" },
          { "nodeId": "salutation", "field": "content", "type": "text", "name": "salutation" },
          { "nodeId": "body", "field": "content", "type": "text", "name": "body" },
          { "nodeId": "signName", "field": "content", "type": "text", "name": "sign_name" }
        ]
      }
    }
  ]
}
