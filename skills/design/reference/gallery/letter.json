{
  "_note": "Exemplar: business letter / letterhead, Midnight palette. The palette here is INCIDENTAL — the exemplar demonstrates structure; restyle to the palette chosen in the style-intent step unless the user asked for this exact look. Slim letterhead rule (not a heavy band), sender block, date, recipient, body, sign-off. Mostly left-aligned, generous whitespace. The long body text carries maxWidth: 495 so it wraps at the content rail and the server derives its height. Bound elements carry the variable name as their element name. Adapt copy/variables; preview and revise.",
  "name": "Letter",
  "actions": [
    { "type": "add_element", "args": { "type": "text", "name": "sender", "position": { "x": 50, "y": 50 }, "data": { "content": "Acme Tech Solutions" }, "styles": { "fontFamily": "Poppins", "fontSize": 18, "bold": true, "color": "#0F172A", "textAlign": "left" } } },
    { "type": "add_element", "args": { "type": "text", "name": "sender_address", "position": { "x": 50, "y": 74 }, "data": { "content": "221 Innovation Way · San Francisco, CA" }, "styles": { "fontFamily": "Inter", "fontSize": 10, "color": "#64748B", "textAlign": "left" } } },
    { "type": "add_element", "args": { "type": "shape", "name": "head_rule", "position": { "x": 50, "y": 100, "w": 495, "h": 2 }, "data": { "shapeType": "rectangle" }, "styles": { "fill": "#3B82F6" } } },

    { "type": "add_element", "args": { "type": "text", "name": "letter_date", "position": { "x": 50, "y": 130 }, "data": { "content": "7 June 2026" }, "styles": { "fontFamily": "Inter", "fontSize": 11, "color": "#0F172A", "textAlign": "left" } } },

    { "type": "add_element", "args": { "type": "text", "name": "recipient_block", "position": { "x": 50, "y": 168, "maxWidth": 360 }, "data": { "content": "Ms. Dana Howard\nDirector of Operations\nGlobex Corporation" }, "styles": { "fontFamily": "Inter", "fontSize": 11, "color": "#0F172A", "lineHeight": 1.4, "textAlign": "left" } } },

    { "type": "add_element", "args": { "type": "text", "name": "salutation", "position": { "x": 50, "y": 244 }, "data": { "content": "Dear Ms. Howard," }, "styles": { "fontFamily": "Inter", "fontSize": 11, "color": "#0F172A", "textAlign": "left" } } },
    { "type": "add_element", "args": { "type": "text", "name": "body", "position": { "x": 50, "y": 274, "maxWidth": 495 }, "data": { "content": "Thank you for taking the time to meet with our team last week. We were glad to learn more about Globex's goals for the coming year, and we believe our consultancy can help you reach them.\n\nEnclosed is a summary of the engagement we discussed, along with proposed timelines and milestones. Please review at your convenience — we are happy to adjust the scope to fit your priorities.\n\nWe look forward to working together." }, "styles": { "fontFamily": "Inter", "fontSize": 11, "color": "#334155", "lineHeight": 1.6, "textAlign": "left" } } },

    { "type": "add_element", "args": { "type": "text", "name": "signoff", "position": { "x": 50, "y": 560 }, "data": { "content": "Sincerely," }, "styles": { "fontFamily": "Inter", "fontSize": 11, "color": "#0F172A", "textAlign": "left" } } },
    { "type": "add_element", "args": { "type": "text", "name": "sign_name", "position": { "x": 50, "y": 600 }, "data": { "content": "Alex Rivera" }, "styles": { "fontFamily": "Source Serif 4", "fontSize": 13, "bold": true, "color": "#0F172A", "textAlign": "left" } } },
    { "type": "add_element", "args": { "type": "text", "name": "sign_title", "position": { "x": 50, "y": 620 }, "data": { "content": "Principal Consultant" }, "styles": { "fontFamily": "Inter", "fontSize": 10, "color": "#64748B", "textAlign": "left" } } },

    { "type": "bind_variable", "args": { "name": "letter_date" } },
    { "type": "bind_variable", "args": { "name": "recipient_block" } },
    { "type": "bind_variable", "args": { "name": "salutation" } },
    { "type": "bind_variable", "args": { "name": "body" } },
    { "type": "bind_variable", "args": { "name": "sign_name" } }
  ]
}
