{
  "_note": "Exemplar: one-page report / summary, Mono/Slate palette. Header band, a row of stat cards (panel rectangles with a big number + label), a section header, body, and a data table. Text has NO w/h; the table is grid-driven via columnWidths. Bound elements carry the variable name as their element name. Adapt copy/variables; preview and revise.",
  "name": "Report",
  "actions": [
    { "type": "add_element", "args": { "type": "shape", "name": "band", "position": { "x": 0, "y": 0, "w": 595.28, "h": 120 }, "data": { "shapeType": "rectangle" }, "styles": { "fill": "#111827" } } },
    { "type": "add_element", "args": { "type": "text", "name": "eyebrow", "position": { "x": 50, "y": 38 }, "data": { "content": "QUARTERLY REVIEW" }, "styles": { "fontFamily": "Inter", "fontSize": 10, "bold": true, "color": "#9CA3AF", "textAlign": "left" } } },
    { "type": "add_element", "args": { "type": "text", "name": "report_title", "position": { "x": 50, "y": 54, "maxWidth": 460 }, "data": { "content": "Sales Performance — Q2 2026" }, "styles": { "fontFamily": "Poppins", "fontSize": 24, "bold": true, "color": "#FFFFFF", "textAlign": "left" } } },

    { "type": "add_element", "args": { "type": "shape", "name": "card_1", "position": { "x": 50, "y": 150, "w": 152, "h": 78 }, "data": { "shapeType": "rectangle" }, "styles": { "fill": "#F3F4F6", "borderRadius": 6 } } },
    { "type": "add_element", "args": { "type": "text", "name": "stat_revenue", "position": { "x": 66, "y": 164 }, "data": { "content": "$1.2M" }, "styles": { "fontFamily": "Poppins", "fontSize": 22, "bold": true, "color": "#111827", "textAlign": "left" } } },
    { "type": "add_element", "args": { "type": "text", "name": "card_1_label", "position": { "x": 66, "y": 196 }, "data": { "content": "REVENUE" }, "styles": { "fontFamily": "Inter", "fontSize": 9, "bold": true, "color": "#6B7280", "textAlign": "left" } } },

    { "type": "add_element", "args": { "type": "shape", "name": "card_2", "position": { "x": 222, "y": 150, "w": 152, "h": 78 }, "data": { "shapeType": "rectangle" }, "styles": { "fill": "#F3F4F6", "borderRadius": 6 } } },
    { "type": "add_element", "args": { "type": "text", "name": "stat_growth", "position": { "x": 238, "y": 164 }, "data": { "content": "+18%" }, "styles": { "fontFamily": "Poppins", "fontSize": 22, "bold": true, "color": "#111827", "textAlign": "left" } } },
    { "type": "add_element", "args": { "type": "text", "name": "card_2_label", "position": { "x": 238, "y": 196 }, "data": { "content": "GROWTH" }, "styles": { "fontFamily": "Inter", "fontSize": 9, "bold": true, "color": "#6B7280", "textAlign": "left" } } },

    { "type": "add_element", "args": { "type": "shape", "name": "card_3", "position": { "x": 394, "y": 150, "w": 151, "h": 78 }, "data": { "shapeType": "rectangle" }, "styles": { "fill": "#F3F4F6", "borderRadius": 6 } } },
    { "type": "add_element", "args": { "type": "text", "name": "stat_customers", "position": { "x": 410, "y": 164 }, "data": { "content": "342" }, "styles": { "fontFamily": "Poppins", "fontSize": 22, "bold": true, "color": "#111827", "textAlign": "left" } } },
    { "type": "add_element", "args": { "type": "text", "name": "card_3_label", "position": { "x": 410, "y": 196 }, "data": { "content": "NEW CUSTOMERS" }, "styles": { "fontFamily": "Inter", "fontSize": 9, "bold": true, "color": "#6B7280", "textAlign": "left" } } },

    { "type": "add_element", "args": { "type": "text", "name": "section_header", "position": { "x": 50, "y": 260 }, "data": { "content": "Top regions" }, "styles": { "fontFamily": "Poppins", "fontSize": 16, "bold": true, "color": "#111827", "textAlign": "left" } } },
    { "type": "add_element", "args": { "type": "shape", "name": "section_rule", "position": { "x": 50, "y": 284, "w": 495, "h": 2 }, "data": { "shapeType": "rectangle" }, "styles": { "fill": "#111827" } } },
    { "type": "add_element", "args": { "type": "table", "name": "regions_table", "position": { "x": 50, "y": 298 }, "data": { "rows": 4, "columns": 3, "columnWidths": [255, 120, 120], "template": "headerRow", "headerRow": true, "cells": [
      ["Region", "Revenue", "Growth"],
      ["North America", "$620K", "+22%"],
      ["Europe", "$410K", "+14%"],
      ["Asia-Pacific", "$170K", "+9%"]
    ] } } },

    { "type": "bind_variable", "args": { "name": "report_title" } },
    { "type": "bind_variable", "args": { "name": "stat_revenue" } },
    { "type": "bind_variable", "args": { "name": "stat_growth" } },
    { "type": "bind_variable", "args": { "name": "stat_customers" } },
    { "type": "bind_variable", "args": { "name": "regions_table" } }
  ]
}
